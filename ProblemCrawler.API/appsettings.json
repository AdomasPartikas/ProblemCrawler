{
  "DatabaseSettings": {
    "ConnectionString": "Host=;Database=;Username=;Password=;SslMode=prefer"
  },
  "Collectors": {
    "Scheduling": {
      "Enabled": true,
      "CronExpression": "0 * * * *",
      "TimeZoneId": "UTC",
      "RunOnStartup": false,
      "AllowConcurrentRuns": false
    },
    "Reddit": {
      "RequestDelayMs": 1000,
      "MaxRetries": 3,
      "RequestTimeoutMs": 10000,
      "UserAgent": "ProblemCrawler/1.0 (+https://github.com/yourusername/ProblemCrawler)",
      "MaxPages": 2,
      "FetchComments": true,
      "MaxCommentsPerPost": 0,
      "Sort": "new",
      "TimeRange": "week"
    }
  },
  "Clustering": {
    "Docker": {
      "ImageName": "problemcrawler-cluster"
    },
    "Scheduling": {
      "Enabled": true,
      "CronExpression": "0 2 * * *",
      "TimeZoneId": "UTC",
      "RunOnStartup": false,
      "AllowConcurrentRuns": false
    },
    "Hdbscan": {
      "MinClusterSize": 5
    },
    "SourceTable": "ThreadSynthesizedIdeasEmbedding",
    "IdColumn": "Id",
    "EmbeddingColumn": "Embedding",
    "ClusterIdColumn": "ClusterId",
    "ClusterConfidenceColumn": "ClusterConfidence",
    "ClusterRunIdColumn": "ClusterRunId",
    "ClusterRunTable": "ClusterRun",
    "ProblemClusterTable": "ProblemCluster",
    "IdeaTable": "ThreadSynthesizedIdeas",
    "EmbeddingArchiveTable": "ThreadSynthesizedIdeaEmbeddingArchive",
    "ProblemClusterArchiveTable": "ProblemClusterArchive",
    "Schema": "public",
    "MaxClusterRuns": 10
  },
  "Filtering": {
    "Scheduling": {
      "Enabled": true,
      "CronExpression": "*/30 * * * *",
      "TimeZoneId": "UTC",
      "RunOnStartup": false,
      "AllowConcurrentRuns": false
    },
    "Settings": {
      "BatchSize": 500,
      "MinimumWordCount": 2,
      "MinimumMeaningfulCharacters": 3
    }
  },
  "Wsl": {
    "Password": "",
    "OllamaPath": "/usr/local/bin/ollama"
  },
  "LLMAnalysis": {
    "Scheduling": {
      "Enabled": true,
      "CronExpression": "10 * * * *",
      "TimeZoneId": "UTC",
      "RunOnStartup": false,
      "AllowConcurrentRuns": false
    },
    "Settings": {
      "BatchSize": 25,
      "MaxAttemptsPerItem": 3,
      "MaxRepairAttempts": 3
    },
    "Ollama": {
      "BaseUrl": "http://localhost:11434",
      "Model": "qwen3:8b",
      "GeneratePath": "/api/generate",
      "RequestDelayMs": 500,
      "MaxRetries": 3,
      "RequestTimeoutMs": 500000,
      "EmbedModel": "nomic-embed-text",
      "EmbedPath": "/api/embeddings"
    },
    "OllamaSetup": {
      "Models": "qwen3:8b,nomic-embed-text"
    }
  },
  "ThreadSynthesis": {
    "Scheduling": {
      "Enabled": true,
      "CronExpression": "20 * * * *",
      "TimeZoneId": "UTC",
      "RunOnStartup": false,
      "AllowConcurrentRuns": false
    },
    "Settings": {
      "BatchSize": 25,
      "MaxAttemptsPerThread": 3,
      "MaxRepairAttempts": 3
    }
  },
  "Embedding": {
    "Scheduling": {
      "Enabled": true,
      "CronExpression": "30 * * * *",
      "TimeZoneId": "UTC",
      "RunOnStartup": true,
      "AllowConcurrentRuns": false
    },
    "Settings": {
      "BatchSize": 25
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Hangfire": "Error",
        "System.Net": "Warning",
        "Microsoft.Extensions": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/problemcrawler-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ]
  },
  "AllowedHosts": "*"
}